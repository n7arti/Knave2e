          ];
          var el=document.getElementById('splash-msg'),last=-1;
          function pick(){var i;do{i=Math.random()*m.length|0}while(i===last);last=i;el.style.opacity='0';setTimeout(function(){el.textContent=m[i];el.style.opacity='1'},400)}
          pick();setInterval(pick,5000);
        })();
