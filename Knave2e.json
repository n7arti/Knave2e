  "derivedFields": [
    {
      "key": "ac",
      "label": {
        "en": "Defense",
        "ru": "КД"
      },
      "description": {
        "en": "Knave 2e: defense = 10 + your Armor Class.",
        "ru": "Knave 2e: КД = 10 + ОД."
      },
      "formula": "10 + armor"
    },
    {
      "key": "careers_count",
      "label": {
        "en": "Filled careers",
        "ru": "Заполнено карьер"
      },
      "formula": "if(career_1, 1, 0) + if(career_2, 1, 0) + if(career_3, 1, 0)"
    },
    {
      "key": "level",
      "label": {
        "en": "Level",
        "ru": "Уровень"
      },
      "description": {
        "en": "Grows automatically with XP. Adventurer: level 1 up to 3 XP, then one level per point (4 XP = level 2 ... 12+ XP = level 10). Career: the first career needs 10 XP per level; each extra career lowers the step by 1 (two careers: 9 XP, three: 8 XP).",
        "ru": "Растёт автоматически по мере опыта. Искатель: 1-й уровень до 3 XP, далее уровень за каждый пункт (4 XP = 2-й ... 12+ XP = 10-й). Карьеры: первая карьера — уровень каждые 10 XP; каждая следующая снижает шаг на 1 (две карьеры: 9 XP, три: 8 XP)."
      },
      "formula": "clamp(if(careers_count > 0, floor(xp / (11 - careers_count)), if(xp < 4, 1, xp - 2)), 1, 10)"
    },
    {
      "key": "xp_max",
      "label": {
        "en": "XP needed for the next level",
        "ru": "Опыт до следующего уровня"
      },
      "description": {
        "en": "Knave 2e: an adventurer needs as many XP as the next level (4, then 5..10); a career needs one level per step (10 minus extra careers). At level 10 the bar shows total XP.",
        "ru": "Knave 2e: искателю нужно столько XP, какой следующий уровень (4, затем 5..10); карьере — уровень каждые (10 минус дополнительные карьеры) XP. На 10-м уровне полоса показывает общий опыт."
      },
      "formula": "if(level >= 10, max(xp, 1), if(careers_count > 0, (floor(xp / (11 - careers_count)) + 1) * (11 - careers_count), level + 1))"
    },
    {
      "key": "xp_pct",
      "label": {
        "en": "Progress to next level, %",
        "ru": "Прогресс до след. уровня, %"
      },
      "formula": "if(xp_max, min(if(xp_max > 0, xp * 100 / xp_max, 0), 100), 0)"
    },
    {
      "key": "melee_bonus",
      "label": {
        "en": "Melee attack bonus",
        "ru": "Бонус ближней атаки"
      },
      "formula": "str"
    },
    {
      "key": "ranged_bonus",
      "label": {
        "en": "Ranged attack bonus",
        "ru": "Бонус дальней атаки"
      },
      "formula": "wis"
    },
    {
      "key": "magic_bonus",
      "label": {
        "en": "Magic attack bonus",
        "ru": "Бонус магической атаки"
      },
      "formula": "int"
    }
  ],
  "itemRules": [
    {
      "id": "item-slots",
      "label": {
        "en": "Item slot cost",
        "ru": "Стоимость предмета в слотах"
      },
      "when": "carried == 1",
      "key": "slots",
