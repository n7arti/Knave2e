  "actions": [
    {
      "id": "ability-check",
      "label": {
        "en": "Ability Check",
        "ru": "Проверка характеристики"
      },
      "description": {
        "en": "d20 + ability vs difficulty (usually 15).",
        "ru": "d20 + характеристика против сложности (обычно 15)."
      },
      "usableBy": "owner",
      "steps": [
        {
          "type": "roll",
          "formula": "1d20 + str",
          "captureAs": "check_str"
        },
        {
          "type": "roll",
          "formula": "1d20 + dex",
          "captureAs": "check_dex"
        },
        {
          "type": "roll",
          "formula": "1d20 + con",
          "captureAs": "check_con"
        },
        {
          "type": "roll",
          "formula": "1d20 + int",
          "captureAs": "check_int"
        },
        {
          "type": "roll",
          "formula": "1d20 + wis",
          "captureAs": "check_wis"
        },
        {
          "type": "roll",
          "formula": "1d20 + cha",
          "captureAs": "check_cha"
        }
      ]
    },
    {
      "id": "melee-attack",
      "label": {
        "en": "Melee Attack",
        "ru": "Ближняя атака"
      },
      "description": {
        "en": "d20 + STR vs target defense. 21+ free maneuver, natural 1 breaks the weapon.",
        "ru": "d20 + СИЛ против КД цели. 21+ свободный маневр, натуральная 1 ломает оружие."
      },
      "usableBy": "owner",
      "targeting": {
        "shape": "single",
        "range": 1,
        "maxTargets": 1
      },
      "steps": [
        {
          "type": "roll",
          "formula": "1d20 + str",
          "captureAs": "atk",
          "compare": {
            "threshold": "target_ac",
            "op": "gte"
          }
        },
        {
          "type": "branch",
          "cases": [
            {
              "when": "atk_hit",
              "outcome": "hit",
              "then": [
                {
                  "type": "damage",
                  "formula": "1d6",
                  "damageType": "physical"
                }
              ]
            },
            {
              "when": "true",
              "outcome": "miss",
              "then": []
            }
          ]
        },
        {
          "type": "branch",
          "cases": [
            {
              "when": "atk >= 21",
              "then": [
                {
                  "type": "chat",
                  "text": "21+: бесплатный маневр!"
                }
              ]
            },
            {
              "when": "atk == 1",
              "then": [
                {
                  "type": "chat",
                  "text": "Натуральная 1: оружие сломалось!"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "ranged-attack",
      "label": {
        "en": "Ranged Attack",
        "ru": "Дальняя атака"
      },
      "description": {
        "en": "d20 + WIS vs target defense.",
        "ru": "d20 + МДР против КД цели."
      },
      "usableBy": "owner",
      "targeting": {
        "shape": "single",
        "range": 24,
        "maxTargets": 1
      },
      "steps": [
        {
          "type": "roll",
          "formula": "1d20 + wis",
          "captureAs": "atk",
          "compare": {
            "threshold": "target_ac",
            "op": "gte"
          }
        },
        {
          "type": "branch",
          "cases": [
            {
              "when": "atk_hit",
              "outcome": "hit",
              "then": [
                {
                  "type": "damage",
                  "formula": "1d6",
                  "damageType": "physical"
                }
              ]
            },
            {
              "when": "true",
              "outcome": "miss",
              "then": []
            }
          ]
        }
      ]
    },
    {
      "id": "long-rest",
      "label": {
        "en": "Long Rest",
        "ru": "Длительный отдых"
      },
      "description": {
        "en": "Restore all HP.",
        "ru": "Полностью восстановить ОЗ."
      },
      "usableBy": "owner",
      "steps": [
        {
          "type": "restoreResource",
          "restoreAllOf": "long-rest"
        },
        {
          "type": "chat",
          "text": "Длительный отдых: ОЗ восстановлены."
        }
      ]
    }
  ],
